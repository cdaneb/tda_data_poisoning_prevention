# Virtual environments
venv/
venv312/

# Python cache
__pycache__/
*.pyc
*.pyo

# Claude Code / AI prompt files
.claude/
cc_instructions_*.md

# Large data files (not suitable for GitHub)
data/

# Research paper PDF (copyrighted)
*.pdf
# ...but generated poster/paper figures are project artifacts, not sources.
# Must stay after *.pdf: git applies the last matching pattern.
!figures/*.pdf
# The built poster is a deliverable, not a source PDF. Same rule: must stay
# after *.pdf. Narrow by name so the two source-paper PDFs stay excluded.
!base_poster.pdf

# Generated results (regenerable by running the scripts)
results/*
# Phase M outputs are tracked deliverables (per-cluster purity instrumentation +
# noise capture), not regenerable throwaways. Same shape as the docs/*.md rule
# above: a bare `results/` marks the directory excluded and git won't descend,
# making any negation inert — so exclude the *contents* and re-include by name.
!results/phase_m_*.json
!results/phase_q_*.json
# Phase Q2 artifacts are tracked deliverables too. Needs its own rule: the
# `phase_q_*` pattern above requires a literal underscore after `q`, so it does
# not match `phase_q2_`.
!results/phase_q2_*.json
# Phase Q3 collision audit. Same reason the `phase_q2_` rule needs to exist:
# `phase_q_*` requires a literal underscore after `q`, so it does not match
# `phase_q3_`.
!results/phase_q3_*.json
# Phase Q4 clean-frame deduplication mechanism test.
!results/phase_q4_*.json

# Log files
*.log
*.txt
!requirements.txt
!requirements.lock.txt

# WIRE-specific path overrides (machine-local; see .env.example)
.env.wire

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# CC instruction files
# Exclude the directory's *contents*, not the directory itself: git does not
# descend into an excluded directory, so a negation under `docs/` would be
# silently inert (gitignore(5)). This shape lets the .md negation take effect.
docs/*
!docs/*.md
CLAUDE.md
PHASE_V_INSTRUCTIONS.md

# Phase Q2 machine-local feature cache (regenerable; hashes are published in
# the tracked JSON so the cache is never required to audit a result).
.q2_cache/
URTC_2026_PAPER_SPECIFICATION.tex